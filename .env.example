# This file is a placeholder for environment variables required to run this project.
# Currently, there are no environment variables needed.

# Example of what future variables might look like:
# NEXT_PUBLIC_API_KEY=your_api_key_here
# DATABASE_URL=your_database_url_here
# SECRET_KEY=your_secret_key_here

# "Ask about Zheng" chat (src/app/api/ask). Get a key from Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key
# Optional; models tried in order, falling through when one hits its free-tier quota
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash-lite
# Optional; site-wide questions per day, keep below the free-tier requests-per-day limit
ASK_DAILY_LIMIT=200

# Password for protected pages/routes
PAGE_ACCESS_PASSWORD=password
